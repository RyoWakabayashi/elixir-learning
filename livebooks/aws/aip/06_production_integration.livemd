## クリーンアップ: 必ず実行する

source queue が DLQ を参照しているため、source → DLQ の順に削除します。SQS はキュー削除後、同名キューを再作成できるまで最低60秒必要です。

```elixir
created_queues = Agent.get(queue_ledger, &Enum.reverse/1)
Kino.DataTable.new(created_queues)
```

```elixir
cleanup_results =
  created_queues
  |> Enum.reverse()
  |> Enum.map(fn queue ->
    %{name: queue.name, role: queue.role, result: AWS.SQS.delete_queue(client, %{"QueueUrl" => queue.url})}
  end)

Kino.DataTable.new(
  Enum.map(cleanup_results, fn row -> Map.update!(row, :result, &inspect/1) end)
)
```

```elixir
service_audit =
  Enum.reduce_while(1..30, [], fn _attempt, _last ->
    case AWS.SQS.list_queues(client, %{"QueueNamePrefix" => queue_prefix}) do
      {:ok, body, _} ->
        remaining = Map.get(body, "QueueUrls", [])

        if remaining == [] do
          {:halt, []}
        else
          Process.sleep(1_000)
          {:cont, remaining}
        end

      error ->
        {:halt, [%{"auditError" => inspect(error)}]}
    end
  end)

tag_audit =
  case AWS.ResourceGroupsTaggingAPI.get_resources(client, %{
         "TagFilters" => [
           %{"Key" => "aip:managed-by", "Values" => ["livebook"]},
           %{"Key" => "aip:lab-id", "Values" => [lab_id]}
         ],
         "ResourceTypeFilters" => ["sqs:queue"]
       }) do
    {:ok, body, _} -> Map.get(body, "ResourceTagMappingList", [])
    error -> [%{"auditError" => inspect(error)}]
  end

summary = %{
  lab_id: lab_id,
  service_resources_remaining: length(service_audit),
  tagged_resources_remaining: length(tag_audit),
  cleanup_complete: service_audit == [] and tag_audit == []
}

Kino.Layout.tabs([
  {"結果", Kino.DataTable.new([summary])},
  {"SQS 残存", Kino.DataTable.new(Enum.map(service_audit, &%{queue_url: &1}))},
  {"タグ残存", Kino.DataTable.new(tag_audit)}
])
```

`cleanup_complete` が `true` になるまで実習は完了ではありません。タグ検索には反映遅延があるため、サービス固有の `ListQueues` が空でタグ側だけ残る場合は、少し待って監査セルを再実行してください。台帳を失った場合は `aip:managed-by=livebook` と `aip:owner=<自分>` で期限切れリソースを検索します。
